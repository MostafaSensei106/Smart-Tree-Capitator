{
	"schemaVersion": 1,
	"id": "smart-tree-capitator",
	"version": "${version}",
	"name": "Smart Tree Capitator",
	"description": "Safely fells natural trees in a three-log-per-tick cascade, gathers drops, replants saplings, and offers configurable controls.",
	"authors": [
		"Mostafa Sensei"
	],
	"contact": {
		"homepage": "https://github.com/MostafaSensei106/smart-tree-capitator",
		"sources": "https://github.com/MostafaSensei106/smart-tree-capitator"
	},
	"license": "MIT",
	"icon": "assets/smart-tree-capitator/icon.png",
	"environment": "*",
	"entrypoints": {
		"modmenu": [
			{
				"value": "com.mostafa.sensei.client.config.TreeConfigScreen",
				"adapter": "kotlin"
			}
		],
		"main": [
			{
				"value": "com.mostafa.sensei.SmartTreeCapitator",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.mostafa.sensei.client.SmartTreeCapitatorClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"smart-tree-capitator.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"yet_another_config_lib_v3": "*"
	},
	"recommends": {
		"modmenu": "*"
	}
}
