{
	"schemaVersion": 1,
	"id": "smart-tree-capitator",
	"version": "${version}",
	"name": "Smart Tree Capitator",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/smart-tree-capitator/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "com.mostafa.sensei.SmartTreeCapitator",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.mostafa.sensei.client.SmartTreeCapitatorClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.mostafa.sensei.client.SmartTreeCapitatorDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"smart-tree-capitator.mixins.json",
		{
			"config": "smart-tree-capitator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}